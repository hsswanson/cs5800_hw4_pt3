@startuml
'https://plantuml.com/class-diagram

+class Ship{
#String shipName
#String yearBuilt
+String yearBuilt()
+String getShipName()
+void setShipName(String shipName)
+void setYearBuilt(String yearBuilt)
+String toString()
}

+class CruiseShip{
#int passengers
+int getPassengers()
