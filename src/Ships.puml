+String toString()
}

+class CargoShip{
#int cargoTonnage
+int getCargoTonnage()
+void setCargo_tonnage(int cargoTonnage)
+String toString()
}
Ship <|-- CargoShip
Ship <|-- CruiseShip

@enduml